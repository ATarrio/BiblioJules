# Copy this file to `.env` and adjust as needed.

# --- Database ---------------------------------------------------------------
# Default is a local SQLite file. Because the app uses SQLAlchemy, switching
# to PostgreSQL or MariaDB later is only a matter of changing this URL and
# installing the matching driver (psycopg[binary] or pymysql/mariadb).
#
# SQLite (default):
DATABASE_URL=sqlite:///./data/library.db
#
# PostgreSQL (install: pip install "psycopg[binary]"):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/bibliojules
#
# MariaDB / MySQL (install: pip install pymysql):
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/bibliojules

# Echo every SQL statement to the console (handy while developing).
SQL_ECHO=false

# Timeout (seconds) for calls to the online ISBN lookup services.
ISBN_LOOKUP_TIMEOUT=10

# Open Library asks that you identify your app. This goes in the User-Agent.
APP_CONTACT=bibliophile@example.com
